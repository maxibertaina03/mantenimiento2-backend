# ═══════════════════════════════════════════════════════════════════════════
# Base de datos de PRUEBA.
#
# Copiá este archivo a `.env.prueba` (que está en .gitignore) y completá las
# credenciales del proyecto de Supabase de prueba, NUNCA las de producción.
#
# Es un proyecto de Supabase distinto del de producción, no otro esquema dentro
# del mismo: si comparten proyecto, un reset se lleva puestos los datos reales.
# ═══════════════════════════════════════════════════════════════════════════

# Esta línea es lo que habilita los comandos destructivos (reset, migrate dev).
# El .env de producción no la tiene, y por eso ahí quedan bloqueados.
ENTORNO=prueba

# ── Opción A: Neon (recomendada) ──
# neon.tech → New project. En Connection Details copiar las dos cadenas:
#   DATABASE_URL → la que dice "Pooled connection" (el host lleva `-pooler`)
#   DIRECT_URL   → la "Direct connection", que es la que Prisma usa para migrar
# Neon exige TLS: el `sslmode=require` tiene que quedar.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Opción B: un segundo proyecto de Supabase ──
# Project Settings → Database → Connection string. El pooler es el 6543; la
# conexión directa, el 5432.
# DATABASE_URL="postgresql://postgres.XXXX:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.XXXX:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=3000
FRONTEND_URL=http://localhost:5173

# Sin Clerk local: así se prueba sin depender del login.
# NUNCA poner esto en producción, deja la API completamente abierta.
AUTH_DISABLED=true

# El envío de correo queda apagado en pruebas: no se le manda nada a nadie
# por accidente mientras se prueba.
# BREVO_API_KEY=
MAIL_FROM=mantenimiento@lacteoslastres.com.ar
MAIL_ADMINISTRACION=administracion@lacteoslastres.com.ar

# Clave del baúl de credenciales: 32 bytes en base64 o hexadecimal.
#
# Generá la tuya con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Sin esta variable el baúl queda deshabilitado y el resto del sistema anda
# igual. Lo que nunca pasa es que las contraseñas se guarden en claro.
#
# ATENCIÓN: si se pierde, las contraseñas guardadas NO se recuperan. Guardala
# fuera de la base y fuera del backup. La de producción tiene que ser distinta
# de esta.
CLAVE_SECRETOS=""

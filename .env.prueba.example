# ═══════════════════════════════════════════════════════════════════════════
# Base de datos de PRUEBA.
#
# Copiá este archivo a `.env.prueba` (que está en .gitignore) y completá las
# credenciales del proyecto de Supabase de prueba, NUNCA las de producción.
#
# Es un proyecto de Supabase distinto del de producción, no otro esquema dentro
# del mismo: si comparten proyecto, un reset se lleva puestos los datos reales.
# ═══════════════════════════════════════════════════════════════════════════

# Esta línea es lo que habilita los comandos destructivos (reset, migrate dev).
# El .env de producción no la tiene, y por eso ahí quedan bloqueados.
ENTORNO=prueba

# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL usa el pooler (puerto 6543); DIRECT_URL la conexión directa
# (5432), que es la que Prisma necesita para las migraciones.
DATABASE_URL="postgresql://postgres.XXXX:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=3000
FRONTEND_URL=http://localhost:5173

# Sin Clerk local: así se prueba sin depender del login.
# NUNCA poner esto en producción, deja la API completamente abierta.
AUTH_DISABLED=true

# El envío de correo queda apagado en pruebas: no se le manda nada a nadie
# por accidente mientras se prueba.
# BREVO_API_KEY=
MAIL_FROM=mantenimiento@lacteoslastres.com.ar
MAIL_ADMINISTRACION=administracion@lacteoslastres.com.ar

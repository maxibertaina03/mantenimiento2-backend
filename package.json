{
  "name": "mantenimiento2-backend",
  "version": "1.5.0",
  "description": "API de gestión de mantenimiento (stock de materiales) - NestJS + Prisma",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "local:migrar": "dotenv -e .env -- prisma migrate deploy",
    "local:copiar-produccion": "node scripts/copiar-produccion-a-local.mjs",
    "local:seed": "dotenv -e .env -- ts-node prisma/seed.ts",
    "local:studio": "dotenv -e .env -- prisma studio",
    "local:api": "dotenv -e .env -- nest start --watch",
    "local:nueva-migracion": "dotenv -e .env -- node scripts/guardia-entorno.js && dotenv -e .env -- prisma migrate dev",
    "local:reset": "dotenv -e .env -- node scripts/guardia-entorno.js && dotenv -e .env -- prisma migrate reset --force",
    "prueba:migrar": "dotenv -e .env.prueba -- prisma migrate deploy",
    "prueba:nueva-migracion": "dotenv -e .env.prueba -- node scripts/guardia-entorno.js && dotenv -e .env.prueba -- prisma migrate dev",
    "prueba:reset": "dotenv -e .env.prueba -- node scripts/guardia-entorno.js && dotenv -e .env.prueba -- prisma migrate reset --force",
    "prueba:seed": "dotenv -e .env.prueba -- ts-node prisma/seed.ts",
    "prueba:studio": "dotenv -e .env.prueba -- prisma studio",
    "prueba:api": "dotenv -e .env.prueba -- nest start --watch",
    "seed": "ts-node prisma/seed.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.js",
    "test:integracion": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/integracion/jest-integracion.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.13.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "9.47.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}

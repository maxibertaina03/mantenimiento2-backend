# ENTORNO marca contra qué base estás trabajando. Los comandos que pueden
# borrar datos (reset, migrate dev) solo corren con ENTORNO=prueba.
ENTORNO=produccion

# ───────── Base de datos (Supabase Postgres) ─────────
# Usamos Supabase SOLO como Postgres gestionado (ignoramos su Auth propio).
#
# DATABASE_URL -> connection string del POOLER (pgbouncer). La usa la app en runtime.
#   Importante: agregar ?pgbouncer=true para que Prisma no use prepared statements.
# DIRECT_URL   -> conexión DIRECTA (puerto 5432). La usa Prisma SOLO para migraciones.
#
# En Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ───────── Servidor ─────────
PORT=3000

# ───────── CORS ─────────
# Origen del frontend permitido (Vite por defecto corre en 5173).
# Para varios orígenes, separar con coma: http://localhost:5173,https://miapp.com
FRONTEND_URL="http://localhost:5173"

# ───────── Autenticación (Clerk) ─────────
# Dashboard de Clerk -> API Keys.
# CLERK_SECRET_KEY: clave secreta del backend (empieza con sk_test_ / sk_live_).
# CLERK_PUBLISHABLE_KEY: clave pública (pk_test_ / pk_live_). Opcional en el backend.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# AUTH_DISABLED: escape hatch SOLO para desarrollo.
#   "true"  -> deja todos los endpoints abiertos (sin verificar token). Útil mientras
#              configurás Clerk o para probar con Swagger sin login.
#   "false" -> (default seguro) exige un JWT válido de Clerk en cada request.
AUTH_DISABLED="false"

# ── Envío automático de órdenes por correo (opcional) ──
#
# Hay dos vías. Si BREVO_API_KEY está cargada se usa esa; si no, cae a SMTP.
#
# Brevo (API HTTP) es la que funciona en Render: el hosting BLOQUEA los puertos
# SMTP salientes, así que con SMTP la conexión se queda esperando y no sale
# ningún correo. Una API sobre HTTPS no se puede bloquear.
BREVO_API_KEY=

# Si falta cualquiera de las tres, el envío automático queda apagado y el
# sistema sigue ofreciendo el envío manual: no rompe nada.
#
# Para Gmail: activar la verificación en dos pasos en la cuenta y generar una
# "contraseña de aplicación" de 16 caracteres. NO es la clave de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mantenimiento.lastres@gmail.com
SMTP_PASS=
# Remitente que ve el proveedor. Por defecto, SMTP_USER.
MAIL_FROM=mantenimiento@lacteoslastres.com.ar
# Copia interna de todas las órdenes enviadas.
MAIL_ADMINISTRACION=administracion@lacteoslastres.com.ar

# WhatsApp de administración, para mandarle una copia de la orden.
# Se escribe como lo escribiría una persona; el sistema lo normaliza.
# Antes estaba escrito en el código del frontend, donde no se puede cambiar sin
# hacer un deploy. Si falta, ese botón simplemente no aparece.
WHATSAPP_ADMINISTRACION=+54 9 3534 40-3519

# ── Fotos de los equipos (opcional) ──
# Si faltan, la carga de fotos queda deshabilitada y el resto del módulo
# funciona igual.
#
# Supabase → Project Settings → API. La service_role da acceso TOTAL a la base:
# va solo en el servidor, nunca en el frontend.
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=
# El bucket tiene que existir y ser público (Storage → New bucket).
SUPABASE_BUCKET=equipos

# ── Avisos de mantenimiento (opcional) ──
# El correo diario con los services que vencen dentro de una semana.
#
# Casilla fija que recibe todos los avisos, además de los administradores.
# Se pueden poner varias separadas por coma.
MAIL_AVISOS=mantenimiento@lacteoslastres.com.ar
# Secreto que autoriza a disparar el envío (POST /api/avisos/procesar).
# Lo usa el workflow de GitHub Actions, que es quien hace de cron: el plan
# gratuito de Render apaga el servidor y un cron interno no se ejecutaría.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El MISMO valor va en el secret TOKEN_AVISOS del repositorio.
# Si falta, el endpoint queda cerrado y no se manda ningún aviso.
TOKEN_AVISOS=

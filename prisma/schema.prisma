// Schema de Prisma — Sistema de gestión de mantenimiento (MVP: stock de materiales)
// Convención: nombres de modelos/campos/enums en español.
// Postgres alojado en Supabase (usado solo como Postgres gestionado).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Pooler (pgbouncer) — usado por la app en runtime.
  directUrl = env("DIRECT_URL") // Conexión directa — usada por Prisma para migraciones.
}

// ───────────────────────── Enums ─────────────────────────

enum TipoMovimiento {
  ENTRADA // Suma al stock
  SALIDA // Resta del stock
  AJUSTE // Fija el stock a un valor absoluto (corrección de inventario)
}

enum MotivoMovimiento {
  COMPRA
  TRABAJO
  AJUSTE
  DEVOLUCION
  OTRO
}

/// Los roles del sistema.
///
/// El rol NO decide por si mismo lo que se puede hacer: decide que permisos
/// tiene, y esos se editan desde la pantalla de administracion. Por eso agregar
/// un rol nuevo es agregar un valor aca, y despues repartirle permisos sin
/// tocar codigo.
enum RolUsuario {
  ADMIN
  /// Mira todo, no toca nada.
  GERENCIA
  /// Administracion de la empresa: solo las ordenes de compra.
  ADMINISTRATIVO
  /// Antes se llamaba OPERARIO. Es quien trabaja en el deposito.
  MANTENIMIENTO
}

/// Que puede hacer cada rol.
///
/// Una fila por permiso concedido. Se edita desde el sistema, asi que cambiar
/// lo que ve gerencia no necesita una version nueva.
///
/// La lista de permisos POSIBLES vive en el codigo (`common/auth/permisos.ts`),
/// porque cada uno corresponde a endpoints concretos: inventar uno desde una
/// pantalla no haria que ningun endpoint empezara a pedirlo.
/// Con que papel llego la mercaderia de una orden.
enum TipoComprobante {
  REMITO
  FACTURA
  OTRO
}

/// El PDF o la foto del remito o la factura de una orden de compra.
///
/// Van varios por orden a proposito: un remito de dos hojas son dos fotos, y
/// una entrega puede venir con remito Y factura. Obligar a elegir uno solo
/// llevaria a sacarle una foto al monton de papeles para que entren todos.
///
/// El archivo NO queda en una direccion publica, al reves que las fotos de los
/// equipos. Un remito lleva el proveedor, las cantidades y los precios: se
/// entrega con un enlace firmado que vence a los pocos minutos.
model ComprobanteOrden {
  id      String          @id @default(uuid())
  ordenId String
  tipo    TipoComprobante @default(REMITO)

  /// Como se llamaba el archivo que subieron, para mostrarlo.
  nombre      String
  /// Donde quedo en el almacen. Es lo que hace falta para verlo y para borrarlo.
  ruta        String
  contentType String
  tamanoBytes Int

  subidoEn    DateTime @default(now())
  subidoPorId String?

  orden     OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  subidoPor Usuario?    @relation("ComprobantesSubidos", fields: [subidoPorId], references: [id])

  @@index([ordenId])
  @@map("comprobantes_orden")
}

model PermisoRol {
  rol     RolUsuario
  permiso String

  creadoEn DateTime @default(now())

  @@id([rol, permiso])
  @@index([rol])
  @@map("permisos_rol")
}

// ───────────────────────── Catálogo ─────────────────────────

model Proveedor {
  id            String   @id @default(uuid())
  nombre        String
  // No es único: en los datos reales hay CUITs repetidos (mismas empresas / sucursales).
  cuit          String?
  email         String?
  telefono      String?
  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  movimientos    MovimientoStock[]
  equiposIt      EquipoIT[]
  ordenes        OrdenCompra[]
  equipos        Equipo[]
  intervenciones Intervencion[]
  trabajos       OrdenTrabajo[]

  @@map("proveedores")
}

model CategoriaMaterial {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  materiales Material[]

  @@map("categorias_material")
}

/// Catálogo de unidades de medida.
///
/// Antes la unidad era texto libre en el material, y eso hacía que "lt", "Lt" y
/// "litros" fueran tres unidades distintas: cualquier reporte que agrupe por
/// unidad daba números que no cierran. Como catálogo, la unidad es un dato
/// analizable.
model UnidadMedida {
  id String @id @default(uuid())

  /// Nombre completo, el que se lee en los desplegables. Ej: "Litro".
  nombre String @unique

  /// Abreviatura que se muestra al lado de las cantidades. Ej: "lt".
  simbolo String @unique

  /// Orden en que se listan. Con el mismo valor, se ordena por nombre.
  orden Int @default(0)

  /// Las unidades en desuso se ocultan en vez de borrarse, para no perder la
  /// referencia de los materiales que ya las usan.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  materiales Material[]

  @@map("unidades_medida")
}

/// Dónde está guardado un material en el depósito.
///
/// Va como catálogo y no como texto libre por lo mismo que las unidades: si
/// cada uno escribe "Estantería A", "estanteria a" y "Est. A", la pregunta
/// "qué hay en la estantería A" deja de tener una sola respuesta.
///
/// La fila NO es un catálogo aparte: es un número, y un número ya es un dato
/// analizable. Cargar cada fila de cada estantería como una fila de tabla sería
/// trabajo de carga sin ninguna garantía a cambio.
model EstanteriaMaterial {
  id     String @id @default(uuid())
  nombre String @unique
  orden  Int    @default(0)

  /// Las estanterías en desuso se ocultan en vez de borrarse, para no perder la
  /// referencia de los materiales que ya las tienen.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  materiales Material[]

  @@map("estanterias_material")
}

model Material {
  id          String @id @default(uuid())
  nombre      String
  categoriaId String

  /// Unidad de medida. Es opcional porque los 831 materiales importados desde
  /// los listados viejos vinieron sin unidad: forzarla habría obligado a
  /// inventar un valor. Al crear un material desde el sistema sí es obligatoria
  /// (lo valida el DTO), así el hueco se achica en vez de crecer.
  unidadId String?

  // stockActual: cantidad actual, DERIVADA de los movimientos.
  // Se recalcula en transacción cada vez que se registra un movimiento.
  stockActual Decimal @default(0) @db.Decimal(14, 3)

  // stockMinimo: umbral para alertas de bajo stock.
  stockMinimo Decimal @default(0) @db.Decimal(14, 3)

  /// Un material fuera de uso se desactiva, no se borra: borrarlo se lleva
  /// puesto su historial de movimientos, que es justamente lo que hay que
  /// conservar. Desactivado sigue existiendo y consultable, pero deja de
  /// aparecer en los desplegables donde se elige qué cargar.
  activo Boolean @default(true)

  /// Dónde está guardado: en qué estantería y en qué fila de esa estantería.
  ///
  /// Las dos son opcionales porque los 924 materiales ya cargados no tienen
  /// ubicación: forzarla habría obligado a inventar un valor. Se completan a
  /// medida que alguien recorre el depósito.
  estanteriaId String?

  /// Número de fila dentro de la estantería. No significa nada sin la
  /// estantería, y el servicio no deja guardar una sin la otra.
  fila Int?

  /// Cuándo se generó la etiqueta con el código QR de este material.
  ///
  /// Igual que en los equipos: es una fecha y no un sí/no, para poder
  /// reimprimir si cambia el formato de la etiqueta y para saber cuáles
  /// quedan sin pegar en el estante.
  qrGeneradoEn DateTime?

  notas         String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  categoria        CategoriaMaterial      @relation(fields: [categoriaId], references: [id])
  unidad           UnidadMedida?          @relation(fields: [unidadId], references: [id])
  estanteria       EstanteriaMaterial?    @relation(fields: [estanteriaId], references: [id])
  usosEnTrabajos   MaterialUsadoTrabajo[]
  movimientos      MovimientoStock[]
  renglonesOrdenes RenglonOrdenCompra[]

  @@index([categoriaId])
  @@index([unidadId])
  @@index([activo])
  @@index([estanteriaId])
  @@map("materiales")
}

// ───────────────────────── Trazabilidad ─────────────────────────

model MovimientoStock {
  id         String           @id @default(uuid())
  materialId String
  tipo       TipoMovimiento
  motivo     MotivoMovimiento

  // Siempre positiva. Para ENTRADA/SALIDA es un delta; para AJUSTE es el valor absoluto final.
  cantidad Decimal @db.Decimal(14, 3)

  fecha DateTime @default(now())

  // Se usa cuando motivo = COMPRA.
  proveedorId String?

  // Quién registró el movimiento (nullable hasta enchufar auth real).
  usuarioId String?

  // Asociar el movimiento a un trabajo (texto libre).
  referenciaTrabajo String?

  notas    String?
  creadoEn DateTime @default(now())

  material      Material            @relation(fields: [materialId], references: [id])
  proveedor     Proveedor?          @relation(fields: [proveedorId], references: [id])
  usuario       Usuario?            @relation(fields: [usuarioId], references: [id])
  ediciones     EdicionMovimiento[]
  renglonOrigen RenglonOrdenCompra?

  /// Si la salida la generó una orden de trabajo, el renglón que la reclama.
  /// Es lo que permite ir del movimiento al trabajo, además de al revés.
  usoEnTrabajo MaterialUsadoTrabajo?

  @@index([materialId])
  // Cubre exactamente el orden que pide recalcularStock (historial de un material).
  @@index([materialId, fecha, creadoEn])
  @@index([tipo])
  @@index([motivo])
  @@index([fecha])
  @@map("movimientos_stock")
}

// Auditoría: registro de cada edición de un movimiento (trazabilidad de correcciones).
model EdicionMovimiento {
  id           String   @id @default(uuid())
  movimientoId String
  usuarioId    String? // quién hizo la edición
  motivo       String // explicación obligatoria del cambio
  cambios      Json // { antes: {...}, despues: {...} }
  creadoEn     DateTime @default(now())

  movimiento MovimientoStock @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  usuario    Usuario?        @relation(fields: [usuarioId], references: [id])

  @@index([movimientoId])
  @@map("ediciones_movimiento")
}

// ───────────────────────── Usuario (preparado para Clerk) ─────────────────────────

model Usuario {
  id     String @id @default(uuid())
  nombre String
  email  String @unique

  // Futuro ID de Clerk. Hoy null (auth desactivada).
  idExterno String? @unique

  rol           RolUsuario @default(MANTENIMIENTO)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  movimientos         MovimientoStock[]
  edicionesMovimiento EdicionMovimiento[]

  asignacionesRegistradas AsignacionEquipoIT[] @relation("AsignacionesRegistradas")
  /// Si esta persona ademas es responsable de equipos, se enlaza desde alla.
  responsable             Responsable?         @relation("UsuarioDelResponsable")

  intervencionesEjecutadas Intervencion[] @relation("IntervencionEjecutor")
  intervencionesCargadas   Intervencion[] @relation("IntervencionRegistro")

  tareasAsignadas     TareaProgramada[]      @relation("TareasAsignadas")
  tareasCreadas       TareaProgramada[]      @relation("TareasCreadas")
  rutinasAsignadas    RutinaTarea[]          @relation("RutinasAsignadas")
  rutinasCreadas      RutinaTarea[]          @relation("RutinasCreadas")
  trabajosAbiertos    OrdenTrabajo[]         @relation("TrabajosAbiertos")
  trabajosAsignados   OrdenTrabajo[]         @relation("TrabajosAsignados")
  trabajosCerrados    OrdenTrabajo[]         @relation("TrabajosCerrados")
  materialesDeTrabajo MaterialUsadoTrabajo[] @relation("MaterialesDeTrabajo")
  ordenesCreadas      OrdenCompra[]          @relation("OrdenesCreadas")
  ordenesRecibidas    OrdenCompra[]          @relation("OrdenesRecibidas")
  enviosDeOrden       EnvioOrden[]           @relation("EnviosDeOrden")

  rotacionesDeCredencial RotacionCredencial[] @relation("RotacionesDeCredencial")
  comprobantesSubidos    ComprobanteOrden[]   @relation("ComprobantesSubidos")
  vistasDeCredencial     VistaCredencial[]    @relation("VistasDeCredencial")

  @@map("usuarios")
}

// ═════════════════════════════ Módulo IT ═════════════════════════════
// Equipos informáticos: activos INDIVIDUALES y rastreables (cada unidad tiene
// su propia identidad y su historial), a diferencia de los materiales, que son
// consumibles fungibles con un stock agregado.

enum EstadoEquipoIT {
  EN_USO
  EN_DEPOSITO
  EN_REPARACION
  DADO_DE_BAJA
}

enum TipoDisco {
  HDD
  SSD
  NVME
  EMMC
}

enum TipoAccesoRemoto {
  NINGUNO
  ANYDESK
  TEAMVIEWER
  RDP
  VNC
  SSH
  OTRO
}

/// Catálogo de tipos de equipo. Antes era un enum, pero agregar un tipo obligaba
/// a tocar el código y migrar: ahora se administran desde el sistema.
model TipoEquipo {
  id     String @id @default(uuid())
  nombre String @unique

  /// Términos que la importación reconoce para este tipo, separados por coma.
  /// Ej: "pc escritorio,pc,computadora".
  alias String?

  /// Si el formulario debe pedir procesador, RAM y disco. Una cámara o una
  /// impresora no los llevan.
  llevaEspecificaciones Boolean @default(true)

  /// Orden en que se listan. Con el mismo valor, se ordena por nombre.
  orden Int @default(0)

  /// Los tipos en desuso se ocultan en vez de borrarse, para no perder la
  /// referencia de los equipos que ya los usan.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipos EquipoIT[]

  @@index([activo, orden])
  @@map("tipos_equipo")
}

/// Quien tiene un equipo de IT a su cargo.
///
/// NO es un usuario del sistema. Se planteo mal al principio: cada persona a la
/// que se le asignaba una notebook entraba como `Usuario` con un correo
/// inventado que terminaba en `@sin-acceso.local` y un rol que nunca usaba. De
/// 35 usuarios, 31 existian solo para figurar en una asignacion.
///
/// Ademas varios responsables no son personas: "Operarios de expedicion",
/// "Queco y German", "Jose Luis y Monica". Un sector, o dos personas
/// compartiendo una maquina, nunca van a poder ser un usuario con clave.
///
/// Quien REGISTRA la asignacion si sigue siendo un `Usuario`: eso es una accion
/// de alguien que entro al sistema.
model Responsable {
  id     String  @id @default(uuid())
  nombre String
  /// En que sector esta. Texto libre por ahora: no hay suficientes datos para
  /// saber si conviene un catalogo.
  sector String?
  notas  String?

  /// Los que dejaron la empresa se desactivan, no se borran: sus asignaciones
  /// pasadas tienen que seguir diciendo quien tenia el equipo.
  activo Boolean @default(true)

  /// Si esta persona ademas entra al sistema, se enlaza con su usuario. Casi
  /// ninguno lo hace, por eso es opcional.
  usuarioId String? @unique

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  usuario      Usuario?             @relation("UsuarioDelResponsable", fields: [usuarioId], references: [id], onDelete: SetNull)
  equiposIt    EquipoIT[]
  asignaciones AsignacionEquipoIT[]

  @@index([activo])
  @@map("responsables")
}

model EquipoIT {
  id String @id @default(uuid())

  // Etiqueta de inventario que se le pega al equipo. Único cuando está cargado.
  codigoInterno String?        @unique
  tipoId        String
  estado        EstadoEquipoIT @default(EN_DEPOSITO)

  /// Marca y modelo salen de los catalogos que ya usan los equipos de planta:
  /// una sola lista de marcas para toda la empresa. Antes eran texto libre y
  /// convivian "Tp Link" y "Tplink" como dos marcas distintas.
  marcaId     String?
  modeloId    String?
  numeroSerie String?

  // Especificaciones técnicas. Todas opcionales a propósito: una cámara de
  // seguridad no tiene RAM ni procesador, pero sí IP y firmware.
  procesador       String?
  memoriaRamGb     Int?
  discoTipo        TipoDisco?
  discoCapacidadGb Int?
  sistemaOperativo String?

  // Red y acceso remoto
  direccionIp    String?
  direccionMac   String?
  nombreEnRed    String?
  accesoRemoto   TipoAccesoRemoto @default(NINGUNO)
  accesoRemotoId String? // ID de AnyDesk / TeamViewer / host de RDP

  /// La ubicacion tambien sale del catalogo compartido: "Laboratorio",
  /// "Envase", "Expedicion", "Saladero" y "Tinas" ya estaban en las dos listas.
  /// Antes eran texto libre y habia 39 valores para 65 equipos, con
  /// "Oficina deposito" junto a "Oficina Deposito".
  ubicacionId String?

  // Compra y garantía
  proveedorId   String?
  fechaCompra   DateTime?
  garantiaHasta DateTime?

  notas String?

  /// Quien tiene el equipo AHORA. El historico vive en asignaciones.
  responsableId String?

  // Clave para ordenar como los nombra la gente: "PC2" antes que "PC10".
  // Se calcula al guardar (ver clave-orden.ts) y se ordena por acá en la base,
  // para que el orden sea correcto también entre páginas.
  ordenClave String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  tipo         TipoEquipo           @relation(fields: [tipoId], references: [id])
  proveedor    Proveedor?           @relation(fields: [proveedorId], references: [id])
  marca        MarcaEquipo?         @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  modelo       ModeloEquipo?        @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  ubicacion    UbicacionEquipo?     @relation(fields: [ubicacionId], references: [id], onDelete: SetNull)
  responsable  Responsable?         @relation(fields: [responsableId], references: [id], onDelete: SetNull)
  asignaciones AsignacionEquipoIT[]
  credenciales Credencial[]

  @@index([tipoId])
  @@index([estado])
  @@index([responsableId])
  @@index([marcaId])
  @@index([ubicacionId])
  @@index([ordenClave])
  @@map("equipos_it")
}

// Historial de asignaciones: quién tuvo cada equipo, desde cuándo y hasta cuándo.
// La asignación vigente es la que tiene `hasta` en null.
model AsignacionEquipoIT {
  id              String  @id @default(uuid())
  equipoId        String
  /// A quien se asigno. Null = se devolvio a deposito.
  responsableId   String?
  /// Quien registro el movimiento: ese si es un usuario del sistema.
  registradoPorId String?

  desde  DateTime  @default(now())
  hasta  DateTime?
  motivo String?
  notas  String?

  creadoEn DateTime @default(now())

  equipo        EquipoIT     @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  responsable   Responsable? @relation(fields: [responsableId], references: [id])
  registradoPor Usuario?     @relation("AsignacionesRegistradas", fields: [registradoPorId], references: [id])

  @@index([equipoId])
  @@index([responsableId])
  @@map("asignaciones_equipo_it")
}

// ═══════════════════════ Módulo Órdenes de Compra ═══════════════════════

enum EstadoOrdenCompra {
  BORRADOR // se puede editar libremente
  EMITIDA // enviada al proveedor, esperando la mercadería
  RECIBIDA // llegó: generó los movimientos de ENTRADA en stock
  ANULADA
}

/// Por dónde salió una orden.
///
/// CORREO sale solo desde el servidor. WHATSAPP no: abre el chat con el texto
/// escrito y la persona toca enviar y adjunta el PDF. Se registran los dos, y
/// el campo dice cuál fue automático y cuál no, para que "se mandó" signifique
/// lo mismo en los dos casos.
enum ViaEnvioOrden {
  CORREO
  WHATSAPP
}

/// Registro de cada vez que una orden salió hacia afuera.
///
/// Sin esto, "¿le mandamos la orden a Fraluga?" no tiene respuesta en el
/// sistema: hay que buscar en la casilla de quien la mandó, si es que fue esa
/// persona la que la mandó. Con varias personas cargando órdenes eso no escala.
model EnvioOrden {
  id      String        @id @default(uuid())
  ordenId String
  via     ViaEnvioOrden

  /// A quiénes se les mandó, separados por coma. En WhatsApp, el número.
  destinatarios String

  /// false en WhatsApp: el sistema abre el chat, pero quien manda es la persona.
  /// Que quede escrito evita leer el registro como si fuera una confirmación de
  /// entrega, que no lo es.
  automatico Boolean @default(true)

  enviadoEn DateTime @default(now())
  usuarioId String?

  orden   OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  usuario Usuario?    @relation("EnviosDeOrden", fields: [usuarioId], references: [id])

  @@index([ordenId])
  @@index([enviadoEn])
  @@map("envios_orden")
}

model OrdenCompra {
  id String @id @default(uuid())

  // Correlativo legible: OC-2026-0001. Lo asigna el backend de forma atómica.
  numero String            @unique
  estado EstadoOrdenCompra @default(BORRADOR)

  proveedorId          String
  fecha                DateTime  @default(now())
  fechaEntregaEstimada DateTime?

  observaciones String?

  creadoPorId   String?
  emitidaEn     DateTime?
  recibidaEn    DateTime?
  recibidaPorId String?

  /// Comprobante con el que llegó la mercadería. Al recibir hay que cargar uno
  /// de los dos: es lo único que ata la entrada de stock al papel que quedó en
  /// la empresa, y sin eso una diferencia de inventario no se puede
  /// reconstruir. Son dos campos y no uno porque a veces llega remito, a veces
  /// factura, y a veces los dos con números distintos.
  remito  String?
  factura String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  proveedor    Proveedor            @relation(fields: [proveedorId], references: [id])
  creadoPor    Usuario?             @relation("OrdenesCreadas", fields: [creadoPorId], references: [id])
  recibidaPor  Usuario?             @relation("OrdenesRecibidas", fields: [recibidaPorId], references: [id])
  renglones    RenglonOrdenCompra[]
  envios       EnvioOrden[]
  comprobantes ComprobanteOrden[]

  @@index([estado])
  @@index([proveedorId])
  @@index([fecha])
  @@map("ordenes_compra")
}

model RenglonOrdenCompra {
  id      String @id @default(uuid())
  ordenId String

  materialId     String
  cantidad       Decimal  @db.Decimal(14, 3)
  // Precio unitario pactado. Opcional: a veces se pide sin precio cerrado.
  precioUnitario Decimal? @db.Decimal(14, 2)
  notas          String?

  // Movimiento de ENTRADA generado al recibir la orden. Es la trazabilidad
  // que une el stock con la OC que lo originó.
  movimientoId String? @unique

  orden      OrdenCompra      @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  material   Material         @relation(fields: [materialId], references: [id])
  movimiento MovimientoStock? @relation(fields: [movimientoId], references: [id])

  @@index([ordenId])
  @@index([materialId])
  @@map("renglones_orden_compra")
}

// Contadores atómicos para numerar documentos (una fila por serie, ej "OC-2026").
// Se incrementa con un INSERT ... ON CONFLICT DO UPDATE, que es atómico y no
// sufre la race de "leer el máximo y sumarle uno".
model ContadorDocumento {
  clave  String @id
  ultimo Int    @default(0)

  @@map("contadores_documento")
}

// ═══════════════════ Contexto: Equipos de planta ═══════════════════
//
// Separado del módulo de Equipos IT a propósito: comparten la mitad de los
// campos pero no la otra mitad ni el control de acceso, y unificarlos obligaría
// a que cada pantalla pregunte "¿es de planta o de sistemas?".
//
// Las reglas de este contexto viven en src/contextos/equipos/dominio, sin
// importar Prisma. Estos modelos son solo la forma en que se guardan.

/// Dónde está el equipo. El catálogo sale de las carpetas de fotos de la
/// planta: Caldera, Tinas, Drenoprensa, Saladero, Recibo, etc.
/// Dónde se ofrece un item del catálogo.
///
/// La tabla es una sola porque hay lugares y marcas que valen para los dos
/// módulos, pero los desplegables no se mezclan: en el de equipos de planta no
/// tiene sentido ofrecer "Abajo de las escaleras oficina", y en el de
/// informática no tiene sentido ofrecer "PRETRATAMIENTO DE SUERO".
enum AmbitoCatalogo {
  PLANTA
  IT
  AMBAS
}

model UbicacionEquipo {
  id     String         @id @default(uuid())
  nombre String         @unique
  orden  Int            @default(0)
  activo Boolean        @default(true)
  ambito AmbitoCatalogo @default(PLANTA)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipos   Equipo[]
  equiposIt EquipoIT[]

  @@map("ubicaciones_equipo")
}

/// Qué clase de equipo es: compresor, bomba, caldera, tina, cinta.
/// Es un catálogo propio, distinto del de Equipos IT.
model TipoEquipoPlanta {
  id     String  @id @default(uuid())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipos Equipo[]

  @@map("tipos_equipo_planta")
}

/// Marca del equipo.
///
/// Era texto libre en la ficha, y por eso "Grundfos", "GRUNDFOS" y "grundfos"
/// eran tres marcas distintas para cualquier reporte. Como catálogo, la
/// pregunta "cuántos equipos Grundfos tenemos" tiene una sola respuesta.
model MarcaEquipo {
  id     String         @id @default(uuid())
  nombre String         @unique
  orden  Int            @default(0)
  activo Boolean        @default(true)
  ambito AmbitoCatalogo @default(PLANTA)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipos   Equipo[]
  equiposIt EquipoIT[]
  modelos   ModeloEquipo[]

  @@map("marcas_equipo")
}

/// Modelo del equipo, colgado de su marca.
///
/// El modelo no existe solo: un "5030" de Grundfos no es el mismo que un "5030"
/// de Siemens. Por eso cuelga de la marca en vez de ser una lista aparte, y por
/// eso el nombre es único DENTRO de cada marca y no en todo el catálogo.
model ModeloEquipo {
  id      String  @id @default(uuid())
  marcaId String
  nombre  String
  orden   Int     @default(0)
  activo  Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  marca     MarcaEquipo @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  equipos   Equipo[]
  equiposIt EquipoIT[]

  @@unique([marcaId, nombre])
  @@index([marcaId])
  @@map("modelos_equipo")
}

model Equipo {
  id String @id @default(uuid())

  /// Opcional pero único cuando está: las fotos de la planta traen nombres,
  /// no códigos, así que exigirlo frenaría la importación.
  codigoInterno String? @unique

  nombre      String
  descripcion String?

  /// Marca y modelo salen de catálogos, no son texto libre: es lo que después
  /// permite filtrar y contar. El número de serie sí es texto, porque es único
  /// de cada máquina y un catálogo no tendría sentido.
  marcaId     String?
  modeloId    String?
  numeroSerie String?

  ubicacionId String?
  tipoId      String?

  /// OPERATIVO | EN_REPARACION | FUERA_DE_SERVICIO | DADO_DE_BAJA.
  /// Va como texto y no como enum de Postgres: agregar un estado a un enum
  /// obliga a migrar, y las transiciones válidas ya las controla el dominio.
  estado String @default("OPERATIVO")

  fotoUrl String?

  /// Cuándo se generó la etiqueta con el código QR de esta máquina.
  ///
  /// Es una fecha y no un sí/no para poder reimprimir las viejas si cambia el
  /// formato de la etiqueta, y para saber cuáles quedan sin pegar.
  qrGeneradoEn DateTime?

  /// A quién se le compró.
  proveedorId String?

  /// Para los equipos que se sirven por horas de funcionamiento y no por
  /// calendario (compresores, calderas).
  horasUso Decimal? @db.Decimal(12, 1)

  fechaAlta     DateTime?
  garantiaHasta DateTime?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  ubicacion      UbicacionEquipo?    @relation(fields: [ubicacionId], references: [id])
  tipo           TipoEquipoPlanta?   @relation(fields: [tipoId], references: [id])
  marca          MarcaEquipo?        @relation(fields: [marcaId], references: [id])
  modelo         ModeloEquipo?       @relation(fields: [modeloId], references: [id])
  proveedor      Proveedor?          @relation(fields: [proveedorId], references: [id])
  intervenciones Intervencion[]
  planes         PlanMantenimiento[]
  ordenesTrabajo OrdenTrabajo[]
  tareas         TareaProgramada[]
  rutinas        RutinaTarea[]

  @@index([ubicacionId])
  @@index([tipoId])
  @@index([marcaId])
  @@index([modeloId])
  @@index([estado])
  @@map("equipos")
}

/// Un trabajo hecho sobre un equipo: el service, la reparación, la mejora.
///
/// Es el corazón de la trazabilidad. No se edita: una intervención cargada es
/// el registro de algo que pasó, y reescribirla lo volvería inservible como
/// respaldo. Si hay un error, se corrige con otra intervención que lo aclare.
model Intervencion {
  id       String @id @default(uuid())
  equipoId String

  /// Si el trabajo corresponde a un plan, registrarlo adelanta su próxima
  /// fecha. Es opcional: una rotura no responde a ningún plan.
  planId String?

  /// PREVENTIVO | CORRECTIVO | MEJORA. Separarlos es lo que después contesta
  /// cuánto del gasto fue planificado y cuánto fue apagar incendios.
  tipo String

  fecha DateTime

  /// INTERNO | EXTERNO. Con el discriminador y las dos relaciones se puede
  /// preguntar "cuánto gastamos con este proveedor", que con un texto libre
  /// sería imposible.
  ejecutor String

  /// Quién lo hizo, si fue en fábrica.
  usuarioId   String?
  /// Quién lo hizo, si fue un tercero.
  proveedorId String?

  descripcion String

  costoManoObra Decimal? @db.Decimal(14, 2)

  /// El costo de una rotura no son los repuestos, es la producción que no
  /// salió. Sin este dato los números cuentan media historia.
  horasParada Decimal? @db.Decimal(8, 2)

  /// Remito, factura o informe del service.
  documentoUrl String?

  /// Quién la cargó en el sistema, que no siempre es quien hizo el trabajo.
  registradoPorId String?

  creadoEn DateTime @default(now())

  equipo        Equipo             @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  plan          PlanMantenimiento? @relation(fields: [planId], references: [id], onDelete: SetNull)
  usuario       Usuario?           @relation("IntervencionEjecutor", fields: [usuarioId], references: [id])
  proveedor     Proveedor?         @relation(fields: [proveedorId], references: [id])
  registradoPor Usuario?           @relation("IntervencionRegistro", fields: [registradoPorId], references: [id])

  @@index([equipoId, fecha])
  @@index([tipo])
  @@index([proveedorId])
  @@index([planId])
  @@map("intervenciones")
}

/// Qué se le hace a un equipo y cada cuánto.
///
/// Un equipo puede tener varios: el aceite cada 90 días y la correa cada 365
/// son dos planes distintos del mismo equipo.
model PlanMantenimiento {
  id       String @id @default(uuid())
  equipoId String

  nombre String
  tareas String?

  /// En días. Podría ser por horas de uso para compresores y calderas, pero eso
  /// necesita un horómetro cargado y se deja para cuando haga falta.
  periodicidadDias Int

  /// Cuándo toca la próxima vez. Se recalcula al registrar un trabajo del plan,
  /// y se puede corregir a mano: en la práctica un service se adelanta o se
  /// corre, y si el sistema no deja moverla la gente deja de usarlo.
  proximaFecha DateTime

  /// Los planes en desuso se desactivan en vez de borrarse, para no perder las
  /// intervenciones que los referencian.
  activo Boolean @default(true)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipo            Equipo            @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  intervenciones    Intervencion[]
  avisos            AvisoEnviado[]
  trabajos          OrdenTrabajo[]
  tareasProgramadas TareaProgramada[]

  @@index([equipoId])
  @@index([proximaFecha])
  @@map("planes_mantenimiento")
}

/// Qué aviso de mantenimiento ya se mandó.
///
/// Es lo que hace idempotente al envío. El disparador corre todos los días; sin
/// este registro, un service vencido que nadie atiende generaría un correo
/// idéntico cada mañana, y a la semana alguien arma una regla de bandeja que
/// los archiva sin leer. Ahí el módulo entero deja de servir.
model AvisoEnviado {
  id     String @id @default(uuid())
  planId String

  /// La fecha de vencimiento del ciclo que se avisó, no la del envío.
  ///
  /// Es la otra mitad de la clave: cuando el trabajo se hace, el plan avanza a
  /// otra fecha y eso habilita el aviso del ciclo siguiente sin tocar nada.
  fechaService DateTime

  enviadoEn DateTime @default(now())

  /// A quiénes se les mandó, separados por coma. Para poder responder "¿por qué
  /// no me llegó?" sin adivinar.
  destinatarios String

  plan PlanMantenimiento @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, fechaService])
  @@index([enviadoEn])
  @@map("avisos_enviados")
}

// ---------------------------------------------------------------------------
// Baúl de credenciales
// ---------------------------------------------------------------------------

/// Qué clase de acceso guarda la credencial. Sirve para filtrar y para saber
/// qué campos tienen sentido: una casilla de correo tiene servidor, una clave
/// de AnyDesk no.
enum TipoCredencial {
  CORREO
  ACCESO_REMOTO
  EQUIPO
  SERVICIO
  RED
  OTRO
}

/// Un acceso guardado: una casilla de correo, la clave de un router, el usuario
/// de un servicio.
///
/// El secreto se guarda cifrado con una clave que vive en el entorno y NO en la
/// base. Un volcado de la base, como el backup que se guarda en disco, no
/// alcanza para leer ninguna contraseña. Ver `modules/credenciales/cofre.ts`.
model Credencial {
  id String @id @default(uuid())

  /// Cómo la llama la gente: "Correo administración", "AnyDesk PC1".
  nombre String
  tipo   TipoCredencial @default(OTRO)

  /// El login, o la dirección de correo. No es secreto y se muestra siempre.
  usuario String?

  /// La contraseña, cifrada. Nunca sale en un listado: para verla hay que
  /// pedirla aparte, y ese pedido queda registrado en `VistaCredencial`.
  secretoCifrado String

  /// La huella de la contraseña ACTUAL, para poder decir "esa ya la usaste"
  /// sin guardar ninguna vieja en claro.
  huella String

  /// Dónde se usa: el webmail, el panel del router.
  url   String?
  notas String?

  /// Opcional: la credencial puede colgar de un equipo de IT, o vivir sola.
  /// Las casillas de correo son el caso de vivir solas.
  equipoItId String?

  /// Cada cuántos días hay que rotarla. Sin esto, no se avisa nada.
  rotarCadaDias   Int?
  rotadaEn        DateTime  @default(now())
  /// Se calcula al guardar, a partir de `rotadaEn` y `rotarCadaDias`. Se guarda
  /// en vez de calcularse al leer para poder filtrar y ordenar por vencimiento
  /// en la base, igual que `ordenClave` en los equipos.
  proximaRotacion DateTime?

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  equipoIt   EquipoIT?            @relation(fields: [equipoItId], references: [id], onDelete: SetNull)
  rotaciones RotacionCredencial[]
  vistas     VistaCredencial[]

  @@index([tipo])
  @@index([equipoItId])
  @@index([proximaRotacion])
  @@map("credenciales")
}

/// Cuándo se rotó una credencial y quién la rotó.
///
/// NO guarda la contraseña anterior, solo su huella. Guardar las viejas
/// multiplicaría el daño de una filtración: en vez de perder la clave vigente,
/// se perderían todas las que se usaron. La huella alcanza para lo que importa,
/// que es impedir volver a una clave ya usada.
model RotacionCredencial {
  id           String   @id @default(uuid())
  credencialId String
  rotadaEn     DateTime @default(now())
  rotadaPorId  String?

  /// La huella de la clave que se dejó de usar.
  huellaAnterior String

  /// Por qué se rotó: vencimiento, sospecha, alguien que se fue.
  motivo String?

  credencial Credencial @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  rotadaPor  Usuario?   @relation("RotacionesDeCredencial", fields: [rotadaPorId], references: [id])

  @@index([credencialId, rotadaEn])
  @@map("rotaciones_credencial")
}

/// Quién vio una contraseña y cuándo.
///
/// Esto es lo que separa un gestor de una planilla: la contraseña no viaja en
/// el listado, hay que pedirla, y el pedido queda anotado. Si alguna vez hay
/// que preguntar "quién tuvo acceso a esto", la respuesta existe.
model VistaCredencial {
  id           String   @id @default(uuid())
  credencialId String
  usuarioId    String
  vistaEn      DateTime @default(now())

  credencial Credencial @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation("VistasDeCredencial", fields: [usuarioId], references: [id])

  @@index([credencialId, vistaEn])
  @@index([usuarioId, vistaEn])
  @@map("vistas_credencial")
}

// ═══════════════════ Contexto: Órdenes de trabajo ═══════════════════
//
// Para qué se usó lo que salió del pañol.
//
// Antes una salida por trabajo era una fila de stock con una nota suelta, y ahí
// terminaba el rastro: nadie podía contestar cuánto costó en repuestos arreglar
// una bomba, ni en qué se fueron diez metros de manguera. La orden es donde esas
// dos preguntas se cruzan.
//
// Es un contexto aparte del de equipos a propósito, aunque se toquen: un trabajo
// puede no ser sobre ninguna máquina, y mantenimiento carga órdenes sin ver el
// módulo de equipos.

/// Una orden de trabajo.
model OrdenTrabajo {
  id String @id @default(uuid())

  /// Correlativo legible: OT-2026-0001. Lo asigna el backend de forma atómica,
  /// con el mismo contador que las órdenes de compra.
  numero String @unique

  /// Qué pasó, o para qué es el trabajo. Obligatorio: una orden sin título es
  /// una fila que dentro de un mes no le dice nada a nadie.
  titulo      String
  descripcion String?

  /// PREVENTIVO | CORRECTIVO | MEJORA. Mismo vocabulario que el historial del
  /// equipo, para que las dos mitades del sistema se puedan sumar.
  tipo String

  /// ABIERTA | CERRADA | ANULADA.
  estado String @default("ABIERTA")

  /// Sobre qué máquina, cuando se sabe. Opcional y es una decisión de diseño:
  /// hay trabajos que no son sobre un equipo, y obligar a elegir uno haría que
  /// se cargue cualquiera con tal de poder guardar. Un dato inventado es peor
  /// que uno ausente: el ausente se ve, el inventado ensucia ese historial.
  equipoId String?

  /// Cuándo se hizo el trabajo. Separada de `abiertaEn` porque no son lo mismo:
  /// una orden puede abrirse hoy para registrar algo de la semana pasada. Es la
  /// fecha por la que se ordena el historial de la máquina.
  fecha DateTime @default(now())

  /// INTERNO | EXTERNO. Con el discriminador y las dos relaciones se puede
  /// preguntar cuánto se gastó con un proveedor; con un texto libre, no.
  ejecutor String @default("INTERNO")

  /// Qué proveedor, si el trabajo lo hizo un tercero.
  proveedorId String?

  /// Solo lo que se sabe. No se pone en cero lo que falta: un total que mezcla
  /// "gratis" con "no lo sabemos" es un número que miente, y con ese número se
  /// decide reparar o reemplazar.
  costoManoObra Decimal? @db.Decimal(14, 2)

  /// El costo de una rotura no son los repuestos, es la producción que no
  /// salió. Sin este dato los números cuentan media historia.
  horasParada Decimal? @db.Decimal(8, 2)

  /// El plan de mantenimiento al que responde. Cerrar la orden adelanta su
  /// próxima fecha, contada desde el trabajo real y no desde la planificada.
  planId String?

  abiertaEn    DateTime @default(now())
  abiertaPorId String?

  /// Quién tiene que hacer el trabajo. Obligatoria, y la base lo exige: la
  /// tabla estaba vacía cuando se agregó la columna, así que no hay ninguna
  /// fila vieja que obligue a aflojar la regla.
  ///
  /// Una orden sin dueño es una que nadie puede cerrar y que todos suponen que
  /// va a hacer otro. Solo esta persona puede cargarle materiales y cerrarla;
  /// los demás la ven. El administrador no trabaja por encima: si hace falta
  /// destrabarla, la reasigna, y entonces figura como suya.
  asignadoAId String

  /// Qué se hizo finalmente. Obligatoria para cerrar: es lo que va a leer el
  /// que agarre la máquina la próxima vez que falle.
  resolucion   String?
  cerradaEn    DateTime?
  cerradaPorId String?

  motivoAnulacion String?

  creadoEn DateTime @default(now())

  equipo     Equipo?                @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  proveedor  Proveedor?             @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  plan       PlanMantenimiento?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  abiertaPor Usuario?               @relation("TrabajosAbiertos", fields: [abiertaPorId], references: [id])
  asignadoA  Usuario                @relation("TrabajosAsignados", fields: [asignadoAId], references: [id])
  cerradaPor Usuario?               @relation("TrabajosCerrados", fields: [cerradaPorId], references: [id])
  materiales MaterialUsadoTrabajo[]
  tarea      TareaProgramada?

  @@index([estado])
  @@index([equipoId])
  @@index([asignadoAId])
  @@index([proveedorId])
  @@index([planId])
  @@index([fecha])
  @@index([abiertaEn])
  @@index([tipo])
  @@map("ordenes_trabajo")
}

/// Un material que consumió un trabajo.
///
/// `movimientoId` es único y obligatorio, y ahí está toda la idea: cargar un
/// material en una orden no anota un número al costado, genera la salida de
/// stock de verdad. El pañol y la orden no pueden discrepar porque son el mismo
/// hecho registrado una sola vez.
model MaterialUsadoTrabajo {
  id             String @id @default(uuid())
  ordenTrabajoId String
  materialId     String

  cantidad Decimal @db.Decimal(14, 3)

  /// La salida de stock que generó. Uno a uno: un movimiento pertenece a lo
  /// sumo a un renglón de una orden.
  movimientoId String @unique

  registradoPorId String?
  creadoEn        DateTime @default(now())

  orden         OrdenTrabajo    @relation(fields: [ordenTrabajoId], references: [id], onDelete: Cascade)
  material      Material        @relation(fields: [materialId], references: [id])
  movimiento    MovimientoStock @relation(fields: [movimientoId], references: [id])
  registradoPor Usuario?        @relation("MaterialesDeTrabajo", fields: [registradoPorId], references: [id])

  @@index([ordenTrabajoId])
  @@index([materialId])
  @@map("materiales_orden_trabajo")
}

// ═══════════════════ Calendario: tareas programadas ═══════════════════
//
// La pieza que faltaba entre un plan y una orden de trabajo. Un plan es una
// definición que se repite y no se le asigna a nadie; una orden es un hecho
// consumado y no acepta fecha futura. La tarea está en el medio: hay que
// hacerla, alguien tiene que hacerla, y al hacerse se vuelve una orden.

/// Algo que hay que hacer, con fecha y con dueño.
model TareaProgramada {
  id          String  @id @default(uuid())
  titulo      String
  descripcion String?

  /// El día en que hay que hacerla, a medianoche UTC. La hora se descarta:
  /// dos tareas del mismo día son del mismo día aunque se carguen a horas
  /// distintas.
  fecha DateTime

  /// PENDIENTE | HECHA | CANCELADA.
  estado String @default("PENDIENTE")

  /// Quién tiene que hacerla. Puede estar vacía: las que genera un plan nacen
  /// sin dueño porque el sistema sabe que hay un service, no a quién le toca.
  asignadoAId String?

  equipoId       String?
  /// El plan de mantenimiento que la generó, si vino de uno.
  planId         String?
  /// La rutina que la generó, si se repite.
  rutinaId       String?
  /// La orden de trabajo que salió al completarla.
  ordenTrabajoId String? @unique

  creadaPorId String?
  creadoEn    DateTime @default(now())

  asignadoA    Usuario?           @relation("TareasAsignadas", fields: [asignadoAId], references: [id])
  creadaPor    Usuario?           @relation("TareasCreadas", fields: [creadaPorId], references: [id])
  equipo       Equipo?            @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  plan         PlanMantenimiento? @relation(fields: [planId], references: [id], onDelete: Cascade)
  rutina       RutinaTarea?       @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ordenTrabajo OrdenTrabajo?      @relation(fields: [ordenTrabajoId], references: [id], onDelete: SetNull)

  /// Un vencimiento de plan genera UNA tarea, y una repetición de rutina
  /// también. Es lo que hace que generarlas al leer el calendario se pueda
  /// repetir sin duplicar nada. Las cargadas a mano tienen los dos en null, y
  /// en Postgres los nulos no chocan entre sí, así que no se estorban.
  @@unique([planId, fecha])
  @@unique([rutinaId, fecha])
  @@index([fecha])
  @@index([estado])
  @@index([asignadoAId])
  @@index([equipoId])
  @@map("tareas_programadas")
}

/// Algo que se repite y no responde a ningún plan de mantenimiento.
///
/// "Revisar la presión de la caldera todas las mañanas" no es el service de una
/// máquina: es una rutina del día. Cargarla una vez y que el calendario la
/// reparta es la diferencia entre que se haga y que no.
model RutinaTarea {
  id          String  @id @default(uuid())
  titulo      String
  descripcion String?

  /// Cada cuántos días se repite. 1 es todos los días. Se cuenta en días
  /// enteros y no en meses, para que "cada 15" signifique siempre lo mismo.
  cadaDias Int

  desde DateTime
  /// Hasta cuándo. Sin esto, para siempre.
  hasta DateTime?

  equipoId    String?
  /// A quién le toca siempre. Sin esto, cada repetición nace sin dueño.
  asignadoAId String?

  activa      Boolean  @default(true)
  creadaPorId String?
  creadoEn    DateTime @default(now())

  equipo    Equipo?           @relation(fields: [equipoId], references: [id], onDelete: SetNull)
  asignadoA Usuario?          @relation("RutinasAsignadas", fields: [asignadoAId], references: [id])
  creadaPor Usuario?          @relation("RutinasCreadas", fields: [creadaPorId], references: [id])
  tareas    TareaProgramada[]

  @@index([activa])
  @@index([equipoId])
  @@map("rutinas_tarea")
}

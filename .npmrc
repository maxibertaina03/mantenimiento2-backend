# npm se niega a instalar si su versión no cumple "engines" de package.json.
# Existe porque el package-lock que arma un npm viejo no coincide con el que
# espera el del CI, y `npm ci` falla en GitHub aunque acá ande (pasó con
# 11.6 contra 11.19). Si te frena: npm install -g npm@11.19.1
engine-strict=true
